# Database
DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Auth (better-auth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Email (SMTP via nodemailer) — used for password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional, defaults to "Scalo <SMTP_USER>"
EMAIL_FROM=

# Google OAuth (Better Auth social login)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (Google Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# Local MCP server (generated from Dashboard → Organisation → MCP keys)
SCALO_MCP_TOKEN=

# Google Maps (for connector location lookup)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# DataForSEO (for Google Reviews + Trustpilot connectors)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Firecrawl (Community discussion import — server-only)
FIRECRAWL_API_KEY=

# Inngest (background jobs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Dodo Payments
DODOPAYMENTS_API_KEY=
DODOPAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Optional — production deployment URL for Inngest pingback URLs
# APP_BASE_URL=https://yourdomain.com
