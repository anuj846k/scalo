# Database
DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Auth (better-auth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# AI (Google Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=

# Google Maps (for connector location lookup)
